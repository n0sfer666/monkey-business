# Привилегированное Linux-окружение для интеграции:
#  - netns + nft tproxy (ip netns, nftables)
#  - валидация сгенерированного конфига реальным xray (xray -test)
#  - генерация конфига (ucode)
# Запускать только через `make test-integ` (docker run --privileged).
FROM alpine:edge

RUN apk add --no-cache nftables iproute2 iputils ucode curl unzip python3 openssl conntrack-tools

ARG XRAY_VER=latest
RUN set -eu; \
	arch="$(uname -m)"; \
	case "$arch" in \
		aarch64) zip="Xray-linux-arm64-v8a.zip" ;; \
		x86_64)  zip="Xray-linux-64.zip" ;; \
		*) echo "unsupported arch $arch" >&2; exit 1 ;; \
	esac; \
	curl -fsSL "https://github.com/XTLS/Xray-core/releases/${XRAY_VER}/download/${zip}" -o /tmp/x.zip; \
	unzip -oq /tmp/x.zip -d /usr/local/bin xray; \
	chmod +x /usr/local/bin/xray; \
	rm -f /tmp/x.zip; \
	/usr/local/bin/xray version | head -1

# Geo-данные для валидации routing-тегов генератора (geoip:ru, geosite:category-ru, ...)
ENV XRAY_LOCATION_ASSET=/usr/local/share/xray
RUN set -eu; mkdir -p /usr/local/share/xray; \
	curl -fsSL "https://github.com/v2fly/geoip/releases/latest/download/geoip.dat" \
		-o /usr/local/share/xray/geoip.dat; \
	curl -fsSL "https://github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat" \
		-o /usr/local/share/xray/geosite.dat

WORKDIR /w

# Synthetic Hysteria upstreams and client qualification; no production installation.
ARG HYSTERIA_VER=app/v2.13.0
RUN set -eu; \
 case "$(uname -m)" in aarch64) asset=hysteria-linux-arm64 ;; x86_64) asset=hysteria-linux-amd64 ;; *) exit 1 ;; esac; \
 curl -fsSL --max-time 60 "https://github.com/HyNetworks/hysteria/releases/download/${HYSTERIA_VER}/${asset}" -o /tmp/hysteria; \
 curl -fsSL --max-time 20 "https://github.com/HyNetworks/hysteria/releases/download/${HYSTERIA_VER}/hashes.txt" -o /tmp/hashes; \
 expected="$(awk -v name="$asset" '$2 == "build/" name { print $1 }' /tmp/hashes)"; \
 test -n "$expected"; echo "$expected  /tmp/hysteria" | sha256sum -c -; \
 mv /tmp/hysteria /usr/local/bin/hysteria; chmod 755 /usr/local/bin/hysteria; \
 rm /tmp/hashes; hysteria version
