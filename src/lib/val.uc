// Мелкие предикаты, общие для генератора, парсера и хендлеров.
// UCI отдаёт булевы значения строками ("1"/"0"), а тесты и внутренние вызовы — настоящими bool:
// проверять это отдельно в каждом модуле значило бы разъезжаться в трактовке одного и того же поля.

function isTrue(v) {
	return v == true || v == "1" || v == 1;
}

// IP-литерал (v4/v6, с маской или без) отличается от домена: по нему выбирается ip-правило вместо
// доменного, и по нему же решается, нужен ли bootstrap-резолв домена сервера.
function isIpLike(t) {
	if (t == null || t == "")
		return false;
	if (match(t, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(\/[0-9]+)?$/) != null)
		return true;
	if (index(t, ":") >= 0 && match(t, /^[0-9a-fA-F:]+(\/[0-9]+)?$/) != null)
		return true;
	return false;
}

export { isTrue, isIpLike };
