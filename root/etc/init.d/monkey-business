#!/bin/sh /etc/rc.common
# procd init для Xray-core. Конфиг генерируется rpcd (config_apply) в $CONF.
# ВЕРИФИКАЦИЯ: на устройстве/в dev-VM (нужны procd + xray). Логика конфига — host-тесты.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/xray
CONF=/etc/monkey-business/xray.json
FW=/usr/share/monkey-business/firewall
# hysteria2 не встраивается в xray: свой QUIC-стек, отдельный процесс. Он поднимается ВТОРЫМ
# инстансом того же сервиса, чтобы жить и умирать вместе с туннелем — отдельный init-скрипт
# разъехался бы с ним при reload/stop и оставил бы клиент долбиться в сервер без маршрутов.
HPROG=/usr/bin/hysteria
HCONF=/etc/monkey-business/hysteria.json

# enabled (тумблер в UI) — источник истины для рантайма, иначе START=95 поднимал туннель на
# загрузке независимо от выбора пользователя, а любой config_apply при выключенном VPN включал его
# молча. Выключение по-прежнему делает stop (-> flush.sh), гейт лишь не даёт подняться заново.
# Дефолт 0 — тот же, что у watchdog (read_intent) и rpcd (isTrue(undefined)): три разных дефолта на
# одно намерение давали расхождение на обрезанном/старом конфиге (туннель поднят, но UI пишет off и
# watchdog за ним не следит). MB_INTENT=1 — явный обход для пути включения (service_toggle), где
# туннель поднимается ДО commit'а тумблера.
mb_intent() {
	[ "${MB_INTENT:-$(uci -q get monkey-business.global.enabled || echo 0)}" = 1 ]
}

# Пустая опция (`option routing_mode ''`) — это тоже «не задано»: `uci -q get` отдаёт на ней 0 и
# пустую строку, так что `|| echo <дефолт>` не сработал бы, а ucode-двойник считает "" отсутствием.
# Расхождение дефолтов между копиями правила — ровно то, чего мы избегаем.
mb_opt() {
	v="$(uci -q get "monkey-business.global.$1")"
	echo "${v:-$2}"
}

mb_runtime_opt() {
	v="$(ucode /usr/share/monkey-business/runtime-option.uc "$1" "$2")" || return 1
	printf '%s' "${v:-$2}"
}

# Ядерный обход (nft-сеты mb_ru4/mb_ru6) — производная режима маршрутизации, а не отдельный тумблер.
# Он осмыслен ровно там, где регион гонит в direct и сам xray (bypass-local), и только для RU: сеты
# наполняются ru.txt. В gfwlist/global правила geoip:<region> -> direct в конфиге нет, и обход в
# ядре противоречил бы выбранному режиму — часть трафика минует туннель мимо намерения пользователя.
# Здесь расчёт авторитетен для файрвола; тот же расчёт для UI/статуса — directBypass() в
# src/lib/bypass.uc.
mb_direct_bypass() {
	[ "${MB_ROUTING_MODE:-$(mb_runtime_opt routing_mode bypass-local)}" = bypass-local ] &&
		[ "${MB_LOCAL_REGION:-$(mb_runtime_opt local_region ru)}" = ru ] && echo 1 || echo 0
}

# Опция global.direct_bypass удалена: обход стал производным. У того, кто осознанно выставил её в 0
# (прежний README прямо описывал такой рецепт), после апдейта обход включился бы молча — поэтому
# одноразовая миграция: сказать в лог и убрать мёртвый ключ.
mb_migrate_bypass() {
	[ -n "$(uci -q get monkey-business.global.direct_bypass)" ] || return 0
	logger -t monkey-business "direct_bypass option removed: the kernel bypass now follows the split (bypass-local + ru)"
	uci -q delete monkey-business.global.direct_bypass && uci -q commit monkey-business
}

start_service() {
	sh /usr/share/monkey-business/diagnostic-guard.sh || exit 1
	if [ "${MB_APPLYING:-0}" != 1 ]; then
		# rc.common ignores start_service's return code and still submits an empty
		# service. Exit on a busy lock so a concurrent Apply keeps its instances.
		umask 077
		exec 998>>/tmp/mb-runtime/mutation.lock
		flock -n 998 || exit 1
	fi
	# Гонка «watchdog зовёт start, пока пользователь жмёт Off» закрыта тем, что гейт перечитывает uci
	# внутри критической секции: procd.sh берёт flock на fd 1000 ещё при сорсинге (_procd_wrapper),
	# т.е. любой вызов init-скрипта — start в том числе — уже сериализован. Своего procd_lock здесь
	# не нужно (проверено на железе: сразу после сорсинга лок занят).
	# Выключено — не просто не поднимаемся, но и снимаем правила: rc.common зовёт start_service
	# внутри rc_procd, так что при живом xray procd получил бы пустые instances и убил процесс, а
	# kill-switch без flush остался бы поднят и заперл LAN без туннеля. На загрузке flush.sh — no-op.
	mb_intent || { sh "$FW/flush.sh" 2>&1 | logger -t monkey-business; return 1; }
	if [ "${MB_APPLYING:-0}" != 1 ]; then
		MB_EXTERNAL_LOCKED=1 ucode /usr/share/monkey-business/reconcile.uc || exit 1
	fi
	[ -f "$CONF" ] || exit 1
	mb_migrate_bypass

	procd_open_instance
	procd_set_param command /usr/share/monkey-business/engine-run.sh "$PROG" run -c "$CONF"
	procd_set_param env XRAY_LOCATION_ASSET=/usr/share/xray
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance

	# Конфиг клиента пишет rpcd только под hysteria-сервер (и снимает под любым другим) — наличие
	# файла и есть признак «активный сервер сейчас hysteria». Инстанс объявляется ДО apply.sh: xray
	# уже смотрит аутбаундом в его локальный socks.
	if [ -f "$HCONF" ] && [ ! -x "$HPROG" ]; then
		# Молча пропустить нельзя: xray уже смотрит аутбаундом в socks клиента, которого не будет, —
		# снаружи это «интернет пропал», а в логе не осталось бы ни строки о причине.
		logger -t monkey-business "hysteria config present but $HPROG is not executable: the tunnel will have no client"
	fi
	if [ -f "$HCONF" ] && [ -x "$HPROG" ]; then
		procd_open_instance hysteria
		procd_set_param command /usr/share/monkey-business/engine-run.sh "$HPROG" client -c "$HCONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param file "$HCONF"
		procd_close_instance
	fi

	# custom_proxy уезжает в файрвол СЫРЫМ: разбор и валидация живут в apply.sh — он единственный
	# потребитель и единственное место, где известно, что примет nft. Без force-сетов явный выбор
	# пользователя проигрывал ядерному обходу: RU-адрес из «через туннель» отсекался @mb_ru4 return
	# раньше tproxy, до Xray не доходил, и правило в xray.json оставалось мёртвым.
	# RPC Apply retains the old kernel policy until the new engine is ready.
	[ "${MB_KEEP_FIREWALL:-0}" != 1 ] || return 0
	if fw_result="$(MB_LAN_IFACE="${MB_APPLIED_LAN_IFACE:-$(mb_runtime_opt lan_iface br-lan)}" \
		MB_TPROXY_PORT="${MB_APPLIED_TPROXY_PORT:-$(mb_runtime_opt tproxy_port 12345)}" \
		MB_KILL_SWITCH="${MB_APPLIED_KILL_SWITCH:-$(mb_runtime_opt kill_switch 1)}" \
		MB_DIRECT_BYPASS="$(mb_direct_bypass)" \
		MB_FORCE_PROXY="${MB_FORCE_PROXY-$(mb_runtime_opt custom_proxy '')}" \
		sh "$FW/apply.sh" 2>&1)"; then
		printf '%s\n' "$fw_result" | logger -t monkey-business
		if [ -n "${MB_APPLY_TOKEN:-}" ]; then
			case "$MB_APPLY_TOKEN" in *[!a-f0-9]*) return 1 ;; esac
			[ "${#MB_APPLY_TOKEN}" = 32 ] || return 1
			(umask 077; printf '%s\n' "$MB_APPLY_TOKEN" > /tmp/mb-runtime/.firewall-applied.new &&
				mv /tmp/mb-runtime/.firewall-applied.new /tmp/mb-runtime/firewall-applied) || return 1
		fi
	else
		printf '%s\n' "$fw_result" | logger -t monkey-business
		if [ "${MB_APPLYING:-0}" != 1 ]; then ucode /usr/share/monkey-business/startup-ready.uc abort-before-submit; fi
		exit 1
	fi
}

service_started() {
 [ "${MB_APPLYING:-0}" = 1 ] || ucode /usr/share/monkey-business/startup-ready.uc || exit 1
}

stop_service() {
 if [ "${MB_APPLYING:-0}" != 1 ]; then
  ucode /usr/share/monkey-business/private-state.uc dir /tmp/mb-runtime || exit 1
  ucode /usr/share/monkey-business/private-state.uc check /tmp/mb-runtime/mutation.lock || exit 1
  umask 077
  exec 998>>/tmp/mb-runtime/mutation.lock
  flock -n 998 || exit 1
 fi
 MB_STOP_FAILED=0
 if result="$(sh "$FW/flush.sh" 2>&1)"; then
  rm -f /tmp/mb-runtime/stop-error
 else
  MB_STOP_FAILED=1
  ucode /usr/share/monkey-business/private-state.uc write /tmp/mb-runtime/stop-error <<'ERROR'
firewall_cleanup_failed
ERROR
 fi
 printf '%s\n' "$result" | logger -t monkey-business
}

service_stopped() {
 # rc.common ignores stop_service's return value. Report after procd has also
 # stopped the engines, so a failed firewall cleanup cannot keep VPN running.
 [ ! -f /tmp/mb-runtime/stop-error ] || MB_STOP_FAILED=1
 ucode /usr/share/monkey-business/stopped.uc "${MB_STOP_FAILED:-0}" || exit 1
}

# Своя reload_service: rc.common для USE_PROCD подменяет reload на start, а restart_service
# заводить нельзя — он позвал бы stop_service -> flush.sh, и до подъёма xray LAN светит в
# открытую сеть. rc_procd обязателен (голый start_service переобъявления не отправляет вовсе:
# ubus set делает procd_close_service) и вызывается без аргументов (любой $2 сменил бы set на
# add). Дальше procd сам решает по хешу $CONF, бить ли процесс xray; firewall переприменяется
# целиком. Нет $CONF или VPN выключен -> выходим ДО rc_procd: иначе start_service отвалился бы
# внутри него, procd получил бы set с пустыми instances и снёс инстанс, убив живой xray, — причём
# stop_service (а значит flush.sh) не вызывается и kill-switch остался бы поднят: LAN заперт.
reload_service() {
	mb_intent || return 1
	[ -f "$CONF" ] || return 1
	rc_procd start_service
	service_started
}

# service_triggers намеренно нет: $CONF генерит rpcd и сам зовёт reload, а reload-триггер на UCI
# поднимал бы xray на любом uci commit — в том числе при выключенном пользователем VPN.
