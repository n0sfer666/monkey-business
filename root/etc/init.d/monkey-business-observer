#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=9
start_service() {
	sh /usr/share/monkey-business/diagnostic-guard.sh || return 1
	procd_open_instance jobs
	procd_set_param command /usr/bin/ucode /usr/share/monkey-business/availability-daemon.uc
	procd_set_param respawn 3600 1 0
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance observer
	procd_set_param command /usr/bin/ucode /usr/share/monkey-business/observer-daemon.uc
	procd_set_param respawn 3600 1 0
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance recovery
	procd_set_param command /usr/bin/ucode /usr/share/monkey-business/recovery-daemon.uc
	procd_set_param respawn 3600 1 0
	procd_set_param stderr 1
	procd_close_instance
}
